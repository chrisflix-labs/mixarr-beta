  manualUseOnly      Boolean             @default(false)
  failureReason      String?
  analyzedAt         DateTime?
  matchedAt          DateTime?
  processedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
