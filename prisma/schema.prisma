generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             String                            @id @default(uuid())
  plexId                         Int                               @unique
  username                       String
  email                          String?
  thumb                          String?
  accessToken                    String
  defaultServerId                String?
  defaultLibraryId               String?
  createdAt                      DateTime                          @default(now())
  updatedAt                      DateTime                          @updatedAt
  isAdmin                        Boolean                           @default(false)
  servers                        Server[]
  playlistRules                  PlaylistRule[]
  playlistRecipes                PlaylistRecipe[]
  recipeImportStages             RecipeImportStage[]
  recipeImportHistory            RecipeImportHistory[]
  recipeExportHistory            RecipeExportHistory[]
  recipeImportAnalyses           RecipeImportAnalysis[]
  savedRecipeMappingRules        SavedRecipeMappingRule[]
  playlistHistory                PlaylistHistory[]
  playlistHistoryEntries         PlaylistHistoryEntry[]
  generatedPlaylists             GeneratedPlaylist[]
  playlistRegenerations          PlaylistRegeneration[]
  smartMixTuningPresets          SmartMixTuningPreset[]
  blockedTracks                  BlockedTrack[]
  trackExclusions                TrackExclusion[]
  syncSettings                   SyncSettings?
  jobHistory                     JobHistory[]
  metadataCorrections            TrackMetadataCorrection[]         @relation("MetadataCorrectionActor")
  metadataVerifications          TrackMetadataVerification[]       @relation("MetadataVerificationActor")
  metadataCorrectionHistory      TrackMetadataCorrectionHistory[]  @relation("MetadataHistoryActor")
  recentlyAddedSettings          RecentlyAddedSettings?
  recentlyAddedBatches           RecentlyAddedBatch[]
  recentlyAddedRuns              RecentlyAddedAutomationRun[]
  recentlyAddedNotifications     RecentlyAddedNotificationState[]
  playlistAutomationSettings     PlaylistAutomationSettings[]
  betaPreference                 UserBetaPreference?
  betaAccess                     UserBetaAccess?
  betaFeatureUsage               BetaFeatureUsage[]
  betaFeedbackReports            BetaFeedbackReport[]
  recommendationProfile          UserRecommendationProfile?
  playlistPreferenceProfiles     PlaylistPreferenceProfile[]
  trackInteractionEvents         TrackInteractionEvent[]
  personalScoringAdjustments     PersonalScoringAdjustment[]
  trackPreferences               UserTrackPreference[]
  artistPreferences              UserArtistPreference[]
  playlistFitFeedback            PlaylistFitFeedback[]
  transitionFeedback             TransitionFeedback[]
  feedbackEvents                 FeedbackEvent[]
  playlistIdentities             PlaylistIdentity[]
  adaptiveScoringProfile         AdaptiveScoringProfile?
  adaptivePlaylistSettings       AdaptivePlaylistScoringSetting[]
  adaptivePreferenceStats        AdaptivePreferenceStatistic[]
  playbackSettings               PlaybackAwarenessSetting?
  plexUserMappings               PlexUserMapping[]
  playbackProfiles               UserTrackPlaybackProfile[]
  contextProfiles                ContextProfile[]
  contextualMixSettings          ContextualMixSetting?
  playlistRelationships          PlaylistRelationship[]
  playlistProgressionChains      PlaylistProgressionChain[]
  playlistRoleDefinitions        PlaylistRoleDefinition[]
  playlistChainSetting           PlaylistChainSetting?
  playlistChainVersions          PlaylistChainVersion[]            @relation("PlaylistChainVersionCreator")
  sharedCoreTracks               PlaylistSharedCoreTrack[]
  smartMixExplanationPreference  SmartMixExplanationPreference?
  smartMixExplanationGenerations SmartMixExplanationGeneration[]
  smartMixDecisionTraces         SmartMixDecisionTrace[]
  automationPolicy               AutomationPolicy?
  automationProposals            AutomationProposal[]
  automationActivities           AutomationActivity[]
  personalizationImportBackups   PersonalizationImportBackup[]
  personalizationAuditEntries    PersonalizationAuditEntry[]
  managedPlaylists               ManagedPlaylist[]
  orchestrationJobs              PlaylistOrchestrationJob[]
  orchestrationAuditEvents       PlaylistOrchestrationAuditEvent[]
  playlistGroups                 PlaylistGroup[]
  playlistGroupActivities        PlaylistGroupActivity[]
  crossPlaylistVarietySetting    CrossPlaylistVarietySetting?
  playlistPairPolicies           PlaylistPairPolicy[]
  playlistTrackDesignations      PlaylistTrackDesignation[]
  playlistRepairPreviews         PlaylistRepairPreview[]
  playlistOverlapSnapshots       PlaylistOverlapSnapshot[]
  smartRefreshGlobalSetting      SmartRefreshGlobalSetting?
  smartRefreshEvaluations        SmartRefreshEvaluation[]
  libraryCoverageSetting         LibraryCoverageSetting?
  trackRotationStatistics        TrackRotationStatistic[]
  libraryCoverageSnapshots       LibraryCoverageSnapshot[]
  librarySegmentCoverage         LibrarySegmentCoverage[]
  coverageCalculationJobs        CoverageCalculationJob[]
  smartExperiments               SmartExperiment[]                 @relation("SmartExperimentOwner")
  smartExperimentEvents          SmartExperimentEvent[]            @relation("SmartExperimentEventActor")
  smartExperimentDecisions       SmartExperimentDecision[]         @relation("SmartExperimentDecisionActor")
  smartExperimentSetting         SmartExperimentSetting?
  smartActions                   SmartAction[]
  smartActionAuditEvents         SmartActionAuditEvent[]           @relation("SmartActionAuditActor")
  smartActionSetting             SmartActionSetting?
  smartActionAutomationPolicies  SmartActionAutomationPolicy[]
  playlistHealthSetting          PlaylistHealthSetting?
  playlistHealthSnapshots        PlaylistHealthSnapshot[]
  playlistHealthAlerts           PlaylistHealthAlert[]
  playlistHealthAlertEvents      PlaylistHealthAlertEvent[]        @relation("PlaylistHealthAlertEventActor")
  orchestrationPreference        OrchestrationPreference?
  orchestrationTrendSnapshots    OrchestrationTrendSnapshot[]
  orchestrationBackupValidations OrchestrationBackupValidation[]
}

model SyncSettings {
  id                                     String   @id @default(uuid())
  userId                                 String   @unique
  plexPageSize                           Int?
  popularityBatchSize                    Int?
  audioFeatureBatchSize                  Int?
  tagBatchSize                           Int?
  bpmBatchSize                           Int?
  bpmReprocessNoDataFailed               Boolean?
  enableApiBpm                           Boolean?
  enableLocalBpm                         Boolean?
  preferLocalBpm                         Boolean?
  reprocessApiBpmWithLocal               Boolean?
  localBpmAnalysisScope                  String?
  playlistVersionHistoryEnabled          Boolean  @default(true)
  playlistVersionRetention               Int      @default(25)
  saveManualPlaylistVersions             Boolean  @default(true)
  savePlaylistScoreSnapshots             Boolean  @default(true)
  cleanupPlaylistVersionsAutomatically   Boolean  @default(false)
  enableApiAudioFeatures                 Boolean?
  enableLocalAudioFeatures               Boolean?
  preferLocalAudioFeatures               Boolean?
  reprocessApiAudioFeaturesWithLocal     Boolean?
  enableLocalAudioFeatureFallback        Boolean?
  preferApiAudioFeatures                 Boolean?
  allowEstimatedMoodAcousticness         Boolean?
  reprocessLocalAudioFeatures            Boolean?
  localAudioFeaturesScope                String?
  includeEstimatedAudioFeaturesInFilters Boolean?
  audioFeatureMinimumConfidence          Float?
  providerDelayMs                        Int?
  rateLimitBackoffEnabled                Boolean?
  automaticallyShareDuplicateEnrichment  Boolean  @default(true)
  playlistIdentityLearningEnabled        Boolean  @default(true)
  hardDeleteMissingAfterDays             Int?
  createdAt                              DateTime @default(now())
  updatedAt                              DateTime @updatedAt
  revisionCounter                        Int      @default(0)
  user                                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Server {
  id                     String                 @id @default(uuid())
  machineIdentifier      String                 @unique
  name                   String
  uri                    String
  accessToken            String
  userId                 String
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  libraries              Library[]
  playlistRules          PlaylistRule[]
  playlistHistory        PlaylistHistory[]
  playlistHistoryEntries PlaylistHistoryEntry[]
  plexAccounts           PlexAccount[]
  plexUserMappings       PlexUserMapping[]
  playbackEvents         PlexPlaybackEvent[]
  playbackSyncState      PlaybackSyncState?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

model Library {
  id                       String                      @id @default(uuid())
  plexId                   String
  serverId                 String
  name                     String
  type                     String
  server                   Server                      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  artists                  Artist[]
  albums                   Album[]
  tracks                   Track[]
  syncLogs                 SyncLog[]
  healthSnapshot           LibraryHealthSnapshot?
  playlistRules            PlaylistRule[]
  recentlyAddedBatches     RecentlyAddedBatch[]
  canonicalRecordings      CanonicalRecording[]
  plexSyncConflicts        PlexSyncConflict[]
  playlistTrackMemories    PlaylistTrackMemory[]
  playlistMembershipEvents PlaylistMembershipEvent[]
  playbackEvents           PlexPlaybackEvent[]
  managedPlaylists         ManagedPlaylist[]
  orchestrationJobs        PlaylistOrchestrationJob[]
  orchestrationLocks       PlaylistOrchestrationLock[]
  coverageSnapshots        LibraryCoverageSnapshot[]
  smartActions             SmartAction[]
  recipeImportAnalyses     RecipeImportAnalysis[]
  savedRecipeMappingRules  SavedRecipeMappingRule[]
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@unique([serverId, plexId])
}

model LibraryHealthSnapshot {
  id        String   @id @default(uuid())
  libraryId String   @unique
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model Artist {
  id                          String                     @id @default(uuid())
  plexId                      String
  libraryId                   String
  title                       String
  summary                     String?
  thumb                       String?
  addedAt                     DateTime?
  updatedAt                   DateTime?
  viewCount                   Int                        @default(0)
  lastViewedAt                DateTime?
  plexLibraryId               String?
  syncStatus                  String                     @default("active")
  lastSeenAt                  DateTime?
  lastSeenSyncId              String?
  missingSince                DateTime?
  deletedAt                   DateTime?
  library                     Library                    @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  albums                      Album[]
  tracks                      Track[]
  tags                        Tag[]                      @relation("ArtistTags")
  userPreferences             UserArtistPreference[]
  playlistIdentityPreferences PlaylistArtistPreference[]

  @@unique([libraryId, plexId])
  @@index([libraryId, syncStatus])
  @@index([libraryId, lastSeenSyncId])
}

model Album {
  id             String    @id @default(uuid())
  plexId         String
  libraryId      String
  artistId       String
  title          String
  summary        String?
  thumb          String?
  year           Int?
  plexTrackCount Int?
  addedAt        DateTime?
  updatedAt      DateTime?
  viewCount      Int       @default(0)
  lastViewedAt   DateTime?
  plexLibraryId  String?
  syncStatus     String    @default("active")
  lastSeenAt     DateTime?
  lastSeenSyncId String?
  missingSince   DateTime?
  deletedAt      DateTime?
  library        Library   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  artist         Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks         Track[]
  tags           Tag[]     @relation("AlbumTags")

  @@unique([libraryId, plexId])
  @@index([libraryId, syncStatus])
  @@index([libraryId, lastSeenSyncId])
}

model Track {
  id                         String                           @id @default(uuid())
  plexId                     String
  ratingKey                  String
  plexGuid                   String?
  plexGuids                  Json?
  mediaPath                  String?
  plexServerId               String
  plexMediaPartId            String?
  fileSize                   BigInt?
  fileFormat                 String?
  bitrate                    Int?
  plexMetadata               Json?
  libraryId                  String
  albumId                    String
  artistId                   String
  title                      String
  duration                   Int?
  trackIndex                 Int?
  rating                     Float?
  contentRating              String?
  normalizedTitle            String?
  isExplicit                 Boolean                          @default(false)
  isLive                     Boolean                          @default(false)
  isRemaster                 Boolean                          @default(false)
  isHoliday                  Boolean                          @default(false)
  isIntroOutro               Boolean                          @default(false)
  viewCount                  Int                              @default(0)
  lastViewedAt               DateTime?
  addedAt                    DateTime?
  updatedAt                  DateTime?
  tagsSyncedAt               DateTime?
  genreStatus                String?
  genreAttemptedAt           DateTime?
  genreFailureReason         String?
  popularityStatus           String?
  popularityAttemptedAt      DateTime?
  popularityFailureReason    String?
  bpm                        Float?
  apiBpm                     Float?
  localBpm                   Float?
  effectiveBpm               Float?
  bpmSource                  String?
  bpmConfidence              Float?
  bpmAnalyzedAt              DateTime?
  bpmAnalysisStatus          String?
  bpmAnalysisScope           String?
  bpmFailureReason           String?
  plexLibraryId              String
  syncStatus                 String                           @default("active")
  lastSyncChangeTypes        String?
  duplicateWarning           String?
  syncConflictReason         String?
  canonicalRecordingId       String?
  duplicateConfidence        String?
  duplicateMatchEvidence     Json?
  duplicateReviewStatus      String                           @default("not_duplicate")
  enrichmentProvenance       Json?
  inheritDuplicateEnrichment Boolean                          @default(true)
  preferredDuplicateCopy     Boolean                          @default(false)
  localFileStatus            String                           @default("not_checked")
  localFileCheckedAt         DateTime?
  lastSeenAt                 DateTime?
  lastSeenSyncId             String?
  missingSince               DateTime?
  deletedAt                  DateTime?
  firstSeenAt                DateTime                         @default(now())
  plexAddedAt                DateTime?
  recentlyAddedProcessedAt   DateTime?
  recentlyAddedStatus        String?
  recentlyAddedBatchId       String?
  library                    Library                          @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  album                      Album                            @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist                     Artist                           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tags                       Tag[]                            @relation("TrackTags")
  popularity                 Popularity?
  audioFeature               AudioFeature?
  blockedBy                  BlockedTrack[]
  exclusions                 TrackExclusion[]
  metadataCorrections        TrackMetadataCorrection[]
  metadataVerifications      TrackMetadataVerification[]
  metadataSourceOverrides    TrackMetadataSourceOverride[]
  metadataCorrectionHistory  TrackMetadataCorrectionHistory[]
  recentlyAddedState         RecentlyAddedTrackState?
  recentlyAddedMatches       RecentlyAddedPlaylistMatch[]
  recentlyAddedChanges       RecentlyAddedAutomationChange[]
  interactionEvents          TrackInteractionEvent[]
  userPreferences            UserTrackPreference[]
  playlistFitFeedback        PlaylistFitFeedback[]
  transitionPreviousFeedback TransitionFeedback[]             @relation("TransitionPreviousTrack")
  transitionCurrentFeedback  TransitionFeedback[]             @relation("TransitionCurrentTrack")
  transitionNextFeedback     TransitionFeedback[]             @relation("TransitionNextTrack")
  canonicalRecording         CanonicalRecording?              @relation("CanonicalRecordingTracks", fields: [canonicalRecordingId], references: [id], onDelete: SetNull)
  preferredForRecordings     CanonicalRecording[]             @relation("PreferredEnrichmentTrack")
  plexSyncConflicts          PlexSyncConflict[]
  PlaylistTrackMemory        PlaylistTrackMemory[]
  PlaylistMembershipEvent    PlaylistMembershipEvent[]
  playbackEvents             PlexPlaybackEvent[]
  playbackProfiles           UserTrackPlaybackProfile[]
  playlistDesignations       PlaylistTrackDesignation[]
  playlistChainTransitions   PlaylistChainTransitionTrack[]
  rotationStatistics         TrackRotationStatistic[]
  smartExperimentTracks      SmartExperimentTrack[]

  @@unique([libraryId, plexId])
  @@unique([plexServerId, plexLibraryId, ratingKey])
  @@index([libraryId, syncStatus])
  @@index([libraryId, lastSeenSyncId])
  @@index([libraryId, ratingKey])
  @@index([libraryId, localFileStatus])
  @@index([libraryId, viewCount])
  @@index([canonicalRecordingId, syncStatus])
  @@index([libraryId, duplicateReviewStatus])
  @@index([libraryId, plexGuid])
}

model LibraryCoverageSetting {
  id                            String   @id @default(uuid())
  userId                        String   @unique
  snapshotsEnabled              Boolean  @default(true)
  snapshotFrequencyHours        Int      @default(24)
  snapshotRetentionDays         Int      @default(365)
  coverageHistoryPeriodDays     Int      @default(365)
  includeManualTracks           Boolean  @default(false)
  includeImportedPlaylists      Boolean  @default(false)
  includeDeletedPlaylistHistory Boolean  @default(true)
  minimumMetadataConfidence     Float    @default(0.7)
  minimumAudioFeatureConfidence Float    @default(0.7)
  minimumOpportunityScore       Float    @default(70)
  overuseThreshold              Float    @default(70)
  selectionCooldownDays         Int      @default(14)
  maximumRotationInfluence      Float    @default(3)
  recentlyAddedWindowDays       Int      @default(90)
  excludeExplicitDislikes       Boolean  @default(true)
  excludeNeverRecommend         Boolean  @default(true)
  excludeMissingPlexTracks      Boolean  @default(true)
  excludeDuplicateVersions      Boolean  @default(true)
  allowLiveTracks               Boolean  @default(false)
  allowCompilations             Boolean  @default(true)
  coverageAwareScoringEnabled   Boolean  @default(false)
  coverageInfluenceLevel        String   @default("disabled")
  customInfluenceJson           Json?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  user                          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrackRotationStatistic {
  id                           String    @id @default(uuid())
  userId                       String
  trackId                      String
  eligible                     Boolean   @default(true)
  exclusionReason              String?
  analyzed                     Boolean   @default(false)
  currentlySelected            Boolean   @default(false)
  firstSelectedAt              DateTime?
  lastSelectedAt               DateTime?
  selectionCount               Int       @default(0)
  acceptedSelectionCount       Int       @default(0)
  rejectionCount               Int       @default(0)
  removalCount                 Int       @default(0)
  lockedCount                  Int       @default(0)
  manualAdditionCount          Int       @default(0)
  importedSelectionCount       Int       @default(0)
  uniquePlaylistCount          Int       @default(0)
  generationSelectionCount     Int       @default(0)
  generationConsiderationCount Int       @default(0)
  qualifiedNotSelectedCount    Int       @default(0)
  recentSelectionCount         Int       @default(0)
  historicalBestScore          Float?
  averageSelectionScore        Float?
  baseQualityScore             Float     @default(0)
  personalizedQualityScore     Float?
  metadataConfidence           Float     @default(0)
  audioFeatureConfidence       Float     @default(0)
  compatibilityPotential       Float     @default(0)
  opportunityScore             Float     @default(0)
  overuseScore                 Float     @default(0)
  reasonNeverSelected          String?
  explanationJson              Json?
  calculatedAt                 DateTime  @default(now())
  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  track                        Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId, eligible, analyzed])
  @@index([userId, opportunityScore])
  @@index([userId, overuseScore])
  @@index([userId, firstSelectedAt])
  @@index([userId, lastSelectedAt])
  @@index([trackId])
  @@index([calculatedAt])
}

model LibraryCoverageSnapshot {
  id                      String                   @id @default(uuid())
  userId                  String
  libraryId               String?
  period                  String                   @default("all_time")
  totalTracks             Int                      @default(0)
  eligibleTracks          Int                      @default(0)
  excludedTracks          Int                      @default(0)
  analyzedTracks          Int                      @default(0)
  usedTracks              Int                      @default(0)
  activeTracks            Int                      @default(0)
  neverSelectedTracks     Int                      @default(0)
  highConfidenceNeglected Int                      @default(0)
  overusedTracks          Int                      @default(0)
  eligibleArtists         Int                      @default(0)
  usedArtists             Int                      @default(0)
  eligibleAlbums          Int                      @default(0)
  usedAlbums              Int                      @default(0)
  artistCoverage          Float                    @default(0)
  albumCoverage           Float                    @default(0)
  coveragePercentage      Float                    @default(0)
  rotationFairnessScore   Float                    @default(0)
  recentlyAddedCoverage   Float                    @default(0)
  partialHistory          Boolean                  @default(false)
  explanationJson         Json?
  fingerprint             String
  createdAt               DateTime                 @default(now())
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  library                 Library?                 @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  segments                LibrarySegmentCoverage[]

  @@index([userId, period, createdAt])
  @@index([libraryId, createdAt])
  @@index([fingerprint])
}

model LibrarySegmentCoverage {
  id                  String                  @id @default(uuid())
  userId              String
  snapshotId          String
  dimension           String
  segmentKey          String
  label               String
  parentKey           String?
  eligibleTracks      Int                     @default(0)
  analyzedTracks      Int                     @default(0)
  selectedTracks      Int                     @default(0)
  neverSelectedTracks Int                     @default(0)
  playlistAppearances Int                     @default(0)
  opportunityCount    Int                     @default(0)
  overuseCount        Int                     @default(0)
  coveragePercentage  Float                   @default(0)
  averageUseCount     Float                   @default(0)
  averageQuality      Float                   @default(0)
  demandPercentage    Float?
  preferenceInfluence Float?
  lastSelectedAt      DateTime?
  metadataJson        Json?
  createdAt           DateTime                @default(now())
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot            LibraryCoverageSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, dimension, segmentKey])
  @@index([userId, dimension, coveragePercentage])
  @@index([snapshotId, dimension])
}

model CoverageCalculationJob {
  id                 String    @id @default(uuid())
  userId             String
  libraryId          String?
  status             String    @default("queued")
  trigger            String    @default("manual")
  currentStage       String    @default("queued")
  currentStageNumber Int       @default(0)
  totalStages        Int       @default(10)
  processedTracks    Int       @default(0)
  totalTracks        Int       @default(0)
  percentage         Float     @default(0)
  cursorTrackId      String?
  cancelRequested    Boolean   @default(false)
  attemptCount       Int       @default(0)
  settingsSnapshot   Json?
  resultJson         Json?
  error              String?
  startedAt          DateTime?
  completedAt        DateTime?
  lastHeartbeatAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([status, lastHeartbeatAt])
  @@index([libraryId, status])
}

// v2.2.6 Smart Experiments. Historical configuration, tracks, and metrics are
// stored on the experiment records so later setting or engine changes cannot
// rewrite the meaning of a completed comparison.
model SmartExperiment {
  id                         String                    @id @default(uuid())
  userId                     String
  sourcePlaylistId           String
  originalPlaylistVersionId  String
  name                       String
  hypothesis                 String?
  experimentType             String
  status                     String                    @default("DRAFT")
  publicationMode            String                    @default("PREVIEW_ONLY")
  durationType               String                    @default("MANUAL")
  durationTarget             Int?
  startAt                    DateTime?
  plannedEndAt               DateTime?
  completedAt                DateTime?
  pausedAt                   DateTime?
  pausedDurationSeconds      Int                       @default(0)
  completionReason           String?
  suggestedWinner            String?
  selectedWinner             String?
  winnerConfidence           String?
  recommendationExplanation  Json?
  configurationSchemaVersion Int                       @default(1)
  constantConfiguration      Json
  originalSnapshot           Json
  candidatePoolReference     String?
  librarySnapshotReference   String?
  metadataSnapshotReference  String?
  randomSeed                 String?
  overlapPercentage          Float?
  generatedAt                DateTime?
  finalPlexPlaylistId        String?
  alternatingIntervalHours   Int                       @default(24)
  activeVariant              String?
  lastRotatedAt              DateTime?
  idempotencyKey             String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  user                       User                      @relation("SmartExperimentOwner", fields: [userId], references: [id], onDelete: Cascade)
  sourcePlaylist             GeneratedPlaylist         @relation("SmartExperimentSourcePlaylist", fields: [sourcePlaylistId], references: [id], onDelete: Restrict)
  originalPlaylistVersion    PlaylistRevision          @relation("SmartExperimentOriginalVersion", fields: [originalPlaylistVersionId], references: [id], onDelete: Restrict)
  variants                   SmartExperimentVariant[]
  metrics                    SmartExperimentMetric[]
  tracks                     SmartExperimentTrack[]
  events                     SmartExperimentEvent[]
  decisions                  SmartExperimentDecision[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status, updatedAt])
  @@index([userId, status, completedAt])
  @@index([sourcePlaylistId, createdAt])
  @@index([status, plannedEndAt])
  @@index([status, publicationMode, lastRotatedAt])
  @@index([completedAt])
}

model SmartExperimentVariant {
  id                         String                  @id @default(uuid())
  experimentId               String
  variant                    String
  generatedPlaylistId        String?
  playlistVersionId          String?
  plexPlaylistId             String?
  engineVersion              String
  randomSeed                 String
  configurationSchemaVersion Int                     @default(1)
  configurationSnapshot      Json
  librarySnapshotReference   String?
  candidatePoolReference     String?
  fallbackBehavior           Json?
  missingMetadataConditions  Json?
  personalizationSnapshot    Json?
  generatedTrackCount        Int                     @default(0)
  playlistScore              Float?
  generationStatus           String                  @default("PENDING")
  generationError            String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  experiment                 SmartExperiment         @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  generatedPlaylist          GeneratedPlaylist?      @relation(fields: [generatedPlaylistId], references: [id], onDelete: SetNull)
  playlistVersion            PlaylistRevision?       @relation(fields: [playlistVersionId], references: [id], onDelete: SetNull)
  metrics                    SmartExperimentMetric[]
  tracks                     SmartExperimentTrack[]

  @@unique([experimentId, variant])
  @@index([experimentId, generationStatus])
  @@index([plexPlaylistId])
}

model SmartExperimentMetric {
  id           String                 @id @default(uuid())
  experimentId String
  variantId    String
  metricType   String
  metricValue  Float
  sampleSize   Int                    @default(0)
  source       String
  calculatedAt DateTime               @default(now())
  experiment   SmartExperiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant      SmartExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, metricType, source])
  @@index([experimentId, metricType])
  @@index([experimentId, calculatedAt])
}

model SmartExperimentTrack {
  id                        String                 @id @default(uuid())
  experimentId              String
  variantId                 String
  trackId                   String
  position                  Int
  selectionScore            Float?
  selectionExplanation      Json?
  personalizationInfluenced Boolean                @default(false)
  sharedBetweenVariants     Boolean                @default(false)
  evaluated                 Boolean                @default(false)
  accepted                  Boolean                @default(false)
