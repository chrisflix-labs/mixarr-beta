  maximumRemovalsPerDay          Int       @default(0)
  maximumAdditionsPerWeek        Int       @default(50)
  maximumRemovalsPerWeek         Int       @default(0)
  quietHoursEnabled              Boolean   @default(false)
  quietHoursStart                String    @default("22:00")
  quietHoursEnd                  String    @default("07:00")
  timezone                       String    @default("UTC")
  quietHoursDaysJson             Json?
  allowAnalysisDuringQuietHours  Boolean   @default(true)
  allowProposalsDuringQuietHours Boolean   @default(true)
  requireApprovalForRegeneration Boolean   @default(true)
  paused                         Boolean   @default(false)
  pauseReason                    String?
  pausedAt                       DateTime?
  pausedByUserId                 String?
  migratedNoticeDismissedAt      DateTime?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  revisionCounter                Int       @default(0)
  user                           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paused])
}

model AutomationProposal {
  id                      String                   @id @default(uuid())
  userId                  String
  generatedPlaylistId     String
  source                  String
  status                  String                   @default("PENDING")
  sourceRevisionNumber    Int?
  sourcePlaylistUpdatedAt DateTime
  policyDecisionJson      Json
  policySnapshotJson      Json
  summaryJson             Json?
  warningsJson            Json?
  requestingJobId         String?
  idempotencyKey          String                   @unique
  expiresAt               DateTime?
  reviewedByUserId        String?
  reviewedAt              DateTime?
  rejectionReason         String?
  appliedActivityId       String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedPlaylist       GeneratedPlaylist        @relation(fields: [generatedPlaylistId], references: [id], onDelete: Cascade)
  items                   AutomationProposalItem[]

  @@index([userId, status, createdAt])
  @@index([generatedPlaylistId, status])
  @@index([expiresAt])
}

model AutomationProposalItem {
  id              String             @id @default(uuid())
  proposalId      String
  action          String
  trackId         String?
  plexRatingKey   String?
  positionBefore  Int?
  positionAfter   Int?
  confidence      Int?
  explanationJson Json?
  status          String             @default("PENDING")
  reasonCode      String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  proposal        AutomationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, status])
  @@index([trackId])
}

model AutomationActivity {
  id                   String                   @id @default(uuid())
  userId               String
  generatedPlaylistId  String
  source               String
  status               String
  permissionLevel      String
  reasonCode           String
  summary              String
  proposedAdditions    Int                      @default(0)
  proposedRemovals     Int                      @default(0)
  appliedAdditions     Int                      @default(0)
  appliedRemovals      Int                      @default(0)
  appliedReorders      Int                      @default(0)
  usageAdjustment      Int                      @default(0)
  policySnapshotJson   Json
  decisionJson         Json
  jobId                String?
  proposalId           String?
  playlistRevisionId   String?                  @unique
  plexStateFingerprint String?
  rollbackStatus       String?
  rolledBackAt         DateTime?
  rolledBackByUserId   String?
  error                String?
  createdAt            DateTime                 @default(now())
  completedAt          DateTime?
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedPlaylist    GeneratedPlaylist        @relation(fields: [generatedPlaylistId], references: [id], onDelete: Cascade)
  playlistRevision     PlaylistRevision?        @relation(fields: [playlistRevisionId], references: [id], onDelete: SetNull)
  items                AutomationActivityItem[]

  @@index([userId, createdAt])
  @@index([generatedPlaylistId, createdAt])
  @@index([userId, status, createdAt])
  @@index([userId, source, createdAt])
}

model AutomationActivityItem {
  id              String             @id @default(uuid())
  activityId      String
  action          String
  trackId         String?
  plexRatingKey   String?
  confidence      Int?
  outcome         String
  reasonCode      String?
  explanationJson Json?
  createdAt       DateTime           @default(now())
  activity        AutomationActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, outcome])
  @@index([trackId])
}

model RecentlyAddedPlaylistMatch {
  id                  String                          @id @default(uuid())
  batchId             String?
  trackId             String
  generatedPlaylistId String
  compatibilityScore  Float
  newMusicScore       Float
  confidenceScore     Float
  recommendedSection  String?
  matchReasonsJson    Json
  warningsJson        Json?
  expectedScoreChange Float?
  status              String                          @default("pending")
  createdAt           DateTime                        @default(now())
  reviewedAt          DateTime?
  appliedAt           DateTime?
  batch               RecentlyAddedBatch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  track               Track                           @relation(fields: [trackId], references: [id], onDelete: Cascade)
  generatedPlaylist   GeneratedPlaylist               @relation(fields: [generatedPlaylistId], references: [id], onDelete: Cascade)
  changes             RecentlyAddedAutomationChange[]

  @@unique([trackId, generatedPlaylistId])
  @@index([generatedPlaylistId, status])
  @@index([batchId, status])
}

model RecentlyAddedAutomationRun {
  id                    String                          @id @default(uuid())
  userId                String
  batchId               String?
  triggerType           String                          @default("manual")
  status                String                          @default("scanning")
  phase                 String                          @default("scanning")
  tracksDiscovered      Int                             @default(0)
  tracksAnalyzed        Int                             @default(0)
  tracksQuarantined     Int                             @default(0)
  playlistMatches       Int                             @default(0)
  suggestions           Int                             @default(0)
  automaticallyAdded    Int                             @default(0)
  rejectedOrIgnored     Int                             @default(0)
  playlistsModified     Int                             @default(0)
  warningsJson          Json?
  errorsJson            Json?
  engineVersion         String                          @default("v2.1.0")
  settingsSnapshot      Json
  requiredFeatureFlags  Json?
  requestedScoringModel String?
  requestedAccessLevel  String?
  progressJson          Json?
  lockKey               String?
  startedAt             DateTime                        @default(now())
  completedAt           DateTime?
  approvedBy            String?
  user                  User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch                 RecentlyAddedBatch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  changes               RecentlyAddedAutomationChange[]

  @@index([userId, startedAt])
  @@index([status, startedAt])
}

model RecentlyAddedAutomationChange {
  id                  String                      @id @default(uuid())
  runId               String
  matchId             String?
  trackId             String
  generatedPlaylistId String
  action              String                      @default("add")
  status              String                      @default("pending")
  beforePosition      Int?
  afterPosition       Int?
  scoreBefore         Float?
  scoreAfter          Float?
  reasonsJson         Json?
  approvedBy          String?
  reviewedAt          DateTime?
  appliedAt           DateTime?
  error               String?
  createdAt           DateTime                    @default(now())
  run                 RecentlyAddedAutomationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  match               RecentlyAddedPlaylistMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  track               Track                       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  generatedPlaylist   GeneratedPlaylist           @relation(fields: [generatedPlaylistId], references: [id], onDelete: Cascade)

  @@unique([runId, trackId, generatedPlaylistId, action])
  @@index([runId, status])
  @@index([generatedPlaylistId, status])
}

model RecentlyAddedNotificationState {
  id          String    @id @default(uuid())
  userId      String
  batchKey    String
  triggerType String
  title       String
  message     String
  link        String?
  readAt      DateTime?
  sentAt      DateTime  @default(now())
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, batchKey, triggerType])
  @@index([userId, readAt, sentAt])
}

model ProviderSetting {
  providerKey          String    @id
  enabled              Boolean   @default(false)
  usesPopularity       Boolean   @default(false)
  usesTags             Boolean   @default(false)
  usesBpm              Boolean   @default(false)
  usesAudioFeatures    Boolean   @default(false)
  encryptedCredentials String?
  lastTestStatus       String?
  lastTestMessage      String?
  lastTestAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([enabled])
  @@index([usesPopularity])
  @@index([usesTags])
  @@index([usesBpm])
  @@index([usesAudioFeatures])
}

enum PlaylistPriority {
  HIGH
  NORMAL
  LOW
}

enum PlaylistAutomationState {
  ACTIVE
  PAUSED
  DISABLED
  WAITING
  RUNNING
  BLOCKED
  ERROR
}

enum PlaylistOrchestrationMode {
  COORDINATED
  OBSERVE_ONLY
  DRY_RUN_ONLY
}

enum ManagedPlaylistRelationshipType {
  DEPENDS_ON
  RUNS_AFTER
  RELATED
}

enum PlaylistOrchestrationJobType {
  GENERATE
  REGENERATE
  SYNC
  ANALYZE
  PREVIEW
  DRY_RUN
}

enum PlaylistOrchestrationJobStatus {
  QUEUED
  WAITING
  BLOCKED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  SKIPPED
  STALE
}

enum PlaylistOrchestrationTrigger {
  MANUAL
  SCHEDULED
  RECENTLY_ADDED
  DEPENDENCY
  SYSTEM
  RETRY
}

model ManagedPlaylist {
  id                    String                            @id @default(uuid())
  userId                String
  libraryId             String
  playlistId            String
  generatedPlaylistId   String?                           @unique
  playlistIdentityId    String?                           @unique
  displayName           String
  enabled               Boolean                           @default(true)
  automationEnabled     Boolean                           @default(false)
  priority              PlaylistPriority                  @default(NORMAL)
  automationState       PlaylistAutomationState           @default(DISABLED)
  automationStateReason String?
  orchestrationMode     PlaylistOrchestrationMode         @default(COORDINATED)
  plexAvailable         Boolean                           @default(true)
  lastAvailabilityCheck DateTime?
  lastQueuedAt          DateTime?
  lastStartedAt         DateTime?
  lastCompletedAt       DateTime?
  lastFailedAt          DateTime?
  lastSuccessfulJobId   String?
  currentJobId          String?
  unregisteredAt        DateTime?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  user                  User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  library               Library                           @relation(fields: [libraryId], references: [id], onDelete: Restrict)
  generatedPlaylist     GeneratedPlaylist?                @relation(fields: [generatedPlaylistId], references: [id], onDelete: SetNull)
  playlistIdentity      PlaylistIdentity?                 @relation(fields: [playlistIdentityId], references: [id], onDelete: SetNull)
  relationshipSources   ManagedPlaylistRelationship[]     @relation("ManagedRelationshipSource")
  relationshipTargets   ManagedPlaylistRelationship[]     @relation("ManagedRelationshipTarget")
  jobs                  PlaylistOrchestrationJob[]
  locks                 PlaylistOrchestrationLock[]
  auditEvents           PlaylistOrchestrationAuditEvent[]

  @@unique([userId, playlistId])
  @@index([userId, enabled, automationEnabled])
  @@index([libraryId, automationState])
  @@index([priority, lastQueuedAt])
  @@index([currentJobId])
}

model ManagedPlaylistRelationship {
  id                      String                          @id @default(uuid())
  sourceManagedPlaylistId String
  targetManagedPlaylistId String
  relationshipType        ManagedPlaylistRelationshipType
  enabled                 Boolean                         @default(true)
  priority                Int                             @default(0)
  metadataJson            Json?
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  sourceManagedPlaylist   ManagedPlaylist                 @relation("ManagedRelationshipSource", fields: [sourceManagedPlaylistId], references: [id], onDelete: Restrict)
  targetManagedPlaylist   ManagedPlaylist                 @relation("ManagedRelationshipTarget", fields: [targetManagedPlaylistId], references: [id], onDelete: Restrict)

  @@unique([sourceManagedPlaylistId, targetManagedPlaylistId, relationshipType])
  @@index([sourceManagedPlaylistId, enabled])
  @@index([targetManagedPlaylistId, enabled])
  @@index([createdAt])
}

model PlaylistOrchestrationJob {
  id                     String                            @id @default(uuid())
  userId                 String
  managedPlaylistId      String?
  libraryId              String?
  parentJobId            String?
  rootJobId              String?
  jobType                PlaylistOrchestrationJobType
  status                 PlaylistOrchestrationJobStatus    @default(QUEUED)
  playlistPriority       PlaylistPriority                  @default(NORMAL)
  priority               Int                               @default(0)
  trigger                PlaylistOrchestrationTrigger
  dryRun                 Boolean                           @default(false)
  idempotencyKey         String                            @unique
  requestedAt            DateTime                          @default(now())
  scheduledFor           DateTime                          @default(now())
  startedAt              DateTime?
  completedAt            DateTime?
  failedAt               DateTime?
  cancelledAt            DateTime?
  attemptCount           Int                               @default(0)
  maxAttempts            Int                               @default(1)
  lockedBy               String?
  lockedAt               DateTime?
  heartbeatAt            DateTime?
  leaseExpiresAt         DateTime?
  dependencySnapshotJson Json?
  requestPayloadJson     Json?
  resultSummaryJson      Json?
  operationPhase         String                            @default("PLANNING")
  waitingReason          String?
  errorCode              String?
  errorMessage           String?
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt
  user                   User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedPlaylist        ManagedPlaylist?                  @relation(fields: [managedPlaylistId], references: [id], onDelete: SetNull)
  library                Library?                          @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  locks                  PlaylistOrchestrationLock[]
  auditEvents            PlaylistOrchestrationAuditEvent[]

  @@index([status, scheduledFor])
  @@index([managedPlaylistId, status])
  @@index([playlistPriority, priority, requestedAt])
  @@index([userId, status])
  @@index([userId, status, scheduledFor])
  @@index([libraryId, status])
  @@index([lockedAt])
  @@index([heartbeatAt])
  @@index([leaseExpiresAt])
  @@index([createdAt])
  @@index([rootJobId])
}

model PlaylistOrchestrationLock {
  id                String                   @id @default(uuid())
  conflictKey       String                   @unique
  jobId             String
  managedPlaylistId String?
  libraryId         String?
  ownerId           String
  acquiredAt        DateTime                 @default(now())
  heartbeatAt       DateTime                 @default(now())
  leaseExpiresAt    DateTime
  releasedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  job               PlaylistOrchestrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  managedPlaylist   ManagedPlaylist?         @relation(fields: [managedPlaylistId], references: [id], onDelete: SetNull)
  library           Library?                 @relation(fields: [libraryId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([managedPlaylistId])
  @@index([libraryId])
  @@index([leaseExpiresAt])
  @@index([heartbeatAt])
}

model PlaylistOrchestrationAuditEvent {
  id                String                    @id @default(uuid())
  userId            String?
  managedPlaylistId String?
  jobId             String?
  playlistGroupId   String?
  smartActionId     String?
  experimentId      String?
  operationType     String?
  outcome           String?
  eventType         String
  severity          String                    @default("INFO")
  actorType         String                    @default("SYSTEM")
  actorId           String?
  message           String
  metadataJson      Json?
  createdAt         DateTime                  @default(now())
  user              User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  managedPlaylist   ManagedPlaylist?          @relation(fields: [managedPlaylistId], references: [id], onDelete: SetNull)
  job               PlaylistOrchestrationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([managedPlaylistId, createdAt])
  @@index([jobId, createdAt])
  @@index([eventType, createdAt])
  @@index([userId, severity, createdAt])
  @@index([userId, actorType, createdAt])
  @@index([playlistGroupId, createdAt])
  @@index([smartActionId, createdAt])
  @@index([experimentId, createdAt])
  @@index([operationType, createdAt])
  @@index([outcome, createdAt])
  @@index([createdAt])
}

// v2.2.9 dashboard preferences and onboarding state are isolated from the
// existing runtime settings so an upgrade cannot enable automation.
model OrchestrationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  dashboardTimeRange String   @default("30d")
  onboardingStep     Int      @default(1)
  onboardingComplete Boolean  @default(false)
  automationLevel    String   @default("OBSERVE_ONLY")
  goalsJson          Json     @default("[]")
  safetySettingsJson Json     @default("{}")
  dashboardJson      Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([onboardingComplete, updatedAt])
}

// Cached ecosystem snapshots prevent full playlist/library recalculation on
// dashboard requests and provide truthful missing-data-aware history.
model OrchestrationTrendSnapshot {
  id                        String   @id @default(uuid())
  userId                    String
  managedPlaylistCount      Int      @default(0)
  healthyPlaylistCount      Int      @default(0)
  attentionPlaylistCount    Int      @default(0)
  pausedPlaylistCount       Int      @default(0)
  averageHealthScore        Float?
  libraryCoveragePercentage Float?
  averageOverlapPercentage  Float?
  automationSuccessRate     Float?
  pendingSmartActionCount   Int      @default(0)
  activeExperimentCount     Int      @default(0)
  failedJobCount            Int      @default(0)
  metadataConfidence        Float?
  identityMatch             Float?
  capturedAt                DateTime @default(now())
  metadataJson              Json?
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
}

// Validation history stores only section-level evidence, never backup payloads.
model OrchestrationBackupValidation {
  id                    String   @id @default(uuid())
  userId                String
  sourceName            String?
  status                String
  backupSchemaVersion   String?
  restoreCompatible     Boolean  @default(false)
  estimatedRestoreScope Int      @default(0)
  missingSectionsJson   Json     @default("[]")
  corruptSectionsJson   Json     @default("[]")
  warningsJson          Json     @default("[]")
  errorsJson            Json     @default("[]")
  validatedAt           DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, validatedAt])
  @@index([status, validatedAt])
}
