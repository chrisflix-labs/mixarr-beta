  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([featureKey, createdAt])
}

model RecentlyAddedSettings {
  id                             String    @id @default(uuid())
  userId                         String    @unique
  enabled                        Boolean   @default(false)
  timeWindowDays                 Int       @default(7)
  customTimeWindowDays           Int?
  maxTracksPerRun                Int       @default(500)
  createRecentlyAddedPlaylists   Boolean   @default(false)
  suggestExistingPlaylistMatches Boolean   @default(true)
  autoAddStrongMatches           Boolean   @default(false)
  quarantineUntilAnalyzed        Boolean   @default(true)
  quarantineRule                 String    @default("all_core")
  quarantineTimeoutHours         Int?
  allowLowConfidenceAutomation   Boolean   @default(false)
  scheduledRegenerationEnabled   Boolean   @default(false)
  notificationEnabled            Boolean   @default(false)
  notifyStrongMatches            Boolean   @default(true)
  notifySuggestionsReady         Boolean   @default(true)
  notifyAutomaticAdditions       Boolean   @default(true)
  notifyMixCreated               Boolean   @default(true)
  notifyLowConfidence            Boolean   @default(true)
  notifyFailures                 Boolean   @default(true)
  matchThreshold                 Float     @default(90)
  metadataConfidenceThreshold    Float     @default(75)
  maxAddsPerPlaylist             Int       @default(3)
  maxAddsPerRun                  Int       @default(25)
  requirePreview                 Boolean   @default(true)
  automationPreset               String    @default("balanced")
  scheduleType                   String    @default("manual")
  scheduleExpression             String?
  scheduleTime                   String    @default("02:00")
  scheduleDayOfWeek              Int       @default(0)
  regenerationBehavior           String    @default("add_only")
  staleLockTimeoutMinutes        Int       @default(60)
  playlistNameTemplate           String    @default("Recently Added — {week}")
  recentMixMinimumTrackCount     Int       @default(5)
  recentMixMaximumTrackCount     Int       @default(100)
  recentMixMinimumScore          Float     @default(60)
  recentMixMinimumConfidence     Float     @default(60)
  recentMixPublishToPlex         Boolean   @default(false)
  recentMixVersioned             Boolean   @default(false)
  recentMixLibraryId             String?
  exclusionsJson                 Json?
  lastScanAt                     DateTime?
  lastSuccessfulRunAt            DateTime?
  nextScheduledRunAt             DateTime?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  user                           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecentlyAddedBatch {
  id              String                       @id @default(uuid())
  userId          String
  libraryId       String?
  syncLogId       String?
  source          String                       @default("manual")
  status          String                       @default("detected")
  discoveredCount Int                          @default(0)
  processedCount  Int                          @default(0)
  failedCount     Int                          @default(0)
  startedAt       DateTime                     @default(now())
  completedAt     DateTime?
  createdAt       DateTime                     @default(now())
  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  library         Library?                     @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  trackStates     RecentlyAddedTrackState[]
  matches         RecentlyAddedPlaylistMatch[]
  runs            RecentlyAddedAutomationRun[]

  @@index([userId, createdAt])
  @@index([libraryId, createdAt])
  @@index([syncLogId])
}

model RecentlyAddedTrackState {
  id                 String              @id @default(uuid())
  trackId            String              @unique
  batchId            String?
  status             String              @default("new")
  newMusicScore      Float?
  confidenceScore    Float?
  scoreBreakdownJson Json?
  quarantineReason   String?
  quarantinedAt      DateTime?
  releasedAt         DateTime?
  manualOverride     Boolean             @default(false)
  ignored            Boolean             @default(false)
  neverAutoAdd       Boolean             @default(false)
  doNotSuggest       Boolean             @default(false)
  manualUseOnly      Boolean             @default(false)
  failureReason      String?
  analyzedAt         DateTime?
  matchedAt          DateTime?
  processedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  track              Track               @relation(fields: [trackId], references: [id], onDelete: Cascade)
  batch              RecentlyAddedBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([batchId, status])
  @@index([status, createdAt])
}

model PlaylistAutomationSettings {
  id                               String            @id @default(uuid())
  userId                           String
  generatedPlaylistId              String            @unique
  mode                             String            @default("suggestions")
  excludeFromScheduledRegeneration Boolean           @default(false)
  createdAt                        DateTime          @default(now())
  updatedAt                        DateTime          @updatedAt
  user                             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedPlaylist                GeneratedPlaylist @relation(fields: [generatedPlaylistId], references: [id], onDelete: Cascade)

  @@index([userId, mode])
}

model RecentlyAddedPlaylistMatch {
  id                  String                          @id @default(uuid())
  batchId             String?
  trackId             String
  generatedPlaylistId String
  compatibilityScore  Float
  newMusicScore       Float
  confidenceScore     Float
  recommendedSection  String?
  matchReasonsJson    Json
  warningsJson        Json?
  expectedScoreChange Float?
  status              String                          @default("pending")
  createdAt           DateTime                        @default(now())
  reviewedAt          DateTime?
  appliedAt           DateTime?
  batch               RecentlyAddedBatch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  track               Track                           @relation(fields: [trackId], references: [id], onDelete: Cascade)
  generatedPlaylist   GeneratedPlaylist               @relation(fields: [generatedPlaylistId], references: [id], onDelete: Cascade)
  changes             RecentlyAddedAutomationChange[]

  @@unique([trackId, generatedPlaylistId])
  @@index([generatedPlaylistId, status])
  @@index([batchId, status])
}

model RecentlyAddedAutomationRun {
  id                    String                          @id @default(uuid())
  userId                String
  batchId               String?
  triggerType           String                          @default("manual")
  status                String                          @default("scanning")
  phase                 String                          @default("scanning")
  tracksDiscovered      Int                             @default(0)
  tracksAnalyzed        Int                             @default(0)
  tracksQuarantined     Int                             @default(0)
  playlistMatches       Int                             @default(0)
  suggestions           Int                             @default(0)
  automaticallyAdded    Int                             @default(0)
  rejectedOrIgnored     Int                             @default(0)
  playlistsModified     Int                             @default(0)
  warningsJson          Json?
  errorsJson            Json?
  engineVersion         String                          @default("v2.1.0")
  settingsSnapshot      Json
  requiredFeatureFlags  Json?
  requestedScoringModel String?
  requestedAccessLevel  String?
  progressJson          Json?
  lockKey               String?
  startedAt             DateTime                        @default(now())
  completedAt           DateTime?
  approvedBy            String?
  user                  User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch                 RecentlyAddedBatch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  changes               RecentlyAddedAutomationChange[]

  @@index([userId, startedAt])
  @@index([status, startedAt])
}

model RecentlyAddedAutomationChange {
  id                  String                      @id @default(uuid())
  runId               String
  matchId             String?
  trackId             String
  generatedPlaylistId String
  action              String                      @default("add")
  status              String                      @default("pending")
  beforePosition      Int?
  afterPosition       Int?
  scoreBefore         Float?
  scoreAfter          Float?
  reasonsJson         Json?
  approvedBy          String?
  reviewedAt          DateTime?
  appliedAt           DateTime?
  error               String?
  createdAt           DateTime                    @default(now())
  run                 RecentlyAddedAutomationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  match               RecentlyAddedPlaylistMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  track               Track                       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  generatedPlaylist   GeneratedPlaylist           @relation(fields: [generatedPlaylistId], references: [id], onDelete: Cascade)

  @@unique([runId, trackId, generatedPlaylistId, action])
  @@index([runId, status])
  @@index([generatedPlaylistId, status])
}

model RecentlyAddedNotificationState {
  id          String    @id @default(uuid())
  userId      String
  batchKey    String
  triggerType String
  title       String
  message     String
  link        String?
  readAt      DateTime?
  sentAt      DateTime  @default(now())
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, batchKey, triggerType])
  @@index([userId, readAt, sentAt])
}

model ProviderSetting {
  providerKey          String    @id
  enabled              Boolean   @default(false)
  usesPopularity       Boolean   @default(false)
  usesTags             Boolean   @default(false)
  usesBpm              Boolean   @default(false)
  usesAudioFeatures    Boolean   @default(false)
  encryptedCredentials String?
  lastTestStatus       String?
  lastTestMessage      String?
  lastTestAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([enabled])
  @@index([usesPopularity])
  @@index([usesTags])
  @@index([usesBpm])
  @@index([usesAudioFeatures])
}
