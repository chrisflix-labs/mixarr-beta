model RecentlyAddedBatch {
  id              String                       @id @default(uuid())
  userId          String
  libraryId       String?
  syncLogId       String?
  source          String                       @default("manual")
  status          String                       @default("detected")
  discoveredCount Int                          @default(0)
  processedCount  Int                          @default(0)
  failedCount     Int                          @default(0)
  startedAt       DateTime                     @default(now())
  completedAt     DateTime?
  createdAt       DateTime                     @default(now())
  user            User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  library         Library?                     @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  trackStates     RecentlyAddedTrackState[]
  matches         RecentlyAddedPlaylistMatch[]
  runs            RecentlyAddedAutomationRun[]

  @@index([userId, createdAt])
  @@index([libraryId, createdAt])
  @@index([syncLogId])
}

model RecentlyAddedTrackState {
  id                 String              @id @default(uuid())
  trackId            String              @unique
