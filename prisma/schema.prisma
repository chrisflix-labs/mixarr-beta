generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                           @id @default(uuid())
  plexId                     Int                              @unique
  username                   String
  email                      String?
  thumb                      String?
  accessToken                String
  defaultServerId            String?
  defaultLibraryId           String?
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  isAdmin                    Boolean                          @default(false)
  servers                    Server[]
  playlistRules              PlaylistRule[]
  playlistRecipes            PlaylistRecipe[]
  playlistHistory            PlaylistHistory[]
  playlistHistoryEntries     PlaylistHistoryEntry[]
  generatedPlaylists         GeneratedPlaylist[]
  playlistRegenerations      PlaylistRegeneration[]
  smartMixTuningPresets      SmartMixTuningPreset[]
  blockedTracks              BlockedTrack[]
  trackExclusions            TrackExclusion[]
  syncSettings               SyncSettings?
  jobHistory                 JobHistory[]
  metadataCorrections        TrackMetadataCorrection[]        @relation("MetadataCorrectionActor")
  metadataVerifications      TrackMetadataVerification[]      @relation("MetadataVerificationActor")
  metadataCorrectionHistory  TrackMetadataCorrectionHistory[] @relation("MetadataHistoryActor")
  recentlyAddedSettings      RecentlyAddedSettings?
  recentlyAddedBatches       RecentlyAddedBatch[]
  recentlyAddedRuns          RecentlyAddedAutomationRun[]
  recentlyAddedNotifications RecentlyAddedNotificationState[]
  playlistAutomationSettings PlaylistAutomationSettings[]
  betaPreference             UserBetaPreference?
  betaAccess                 UserBetaAccess?
  betaFeatureUsage           BetaFeatureUsage[]
  betaFeedbackReports        BetaFeedbackReport[]
  recommendationProfile      UserRecommendationProfile?
  playlistPreferenceProfiles PlaylistPreferenceProfile[]
  trackInteractionEvents     TrackInteractionEvent[]
  personalScoringAdjustments PersonalScoringAdjustment[]
  trackPreferences           UserTrackPreference[]
  artistPreferences          UserArtistPreference[]
  playlistFitFeedback        PlaylistFitFeedback[]
  transitionFeedback         TransitionFeedback[]
  feedbackEvents             FeedbackEvent[]
  playlistIdentities         PlaylistIdentity[]
  adaptiveScoringProfile     AdaptiveScoringProfile?
  adaptivePlaylistSettings   AdaptivePlaylistScoringSetting[]
  adaptivePreferenceStats    AdaptivePreferenceStatistic[]
}

model SyncSettings {
  id                                     String   @id @default(uuid())
  userId                                 String   @unique
  plexPageSize                           Int?
  popularityBatchSize                    Int?
  audioFeatureBatchSize                  Int?
  tagBatchSize                           Int?
  bpmBatchSize                           Int?
  bpmReprocessNoDataFailed               Boolean?
  enableApiBpm                           Boolean?
  enableLocalBpm                         Boolean?
  preferLocalBpm                         Boolean?
  reprocessApiBpmWithLocal               Boolean?
  localBpmAnalysisScope                  String?
  playlistVersionHistoryEnabled          Boolean  @default(true)
  playlistVersionRetention               Int      @default(25)
  saveManualPlaylistVersions             Boolean  @default(true)
  savePlaylistScoreSnapshots             Boolean  @default(true)
  cleanupPlaylistVersionsAutomatically   Boolean  @default(false)
  enableApiAudioFeatures                 Boolean?
  enableLocalAudioFeatures               Boolean?
  preferLocalAudioFeatures               Boolean?
  reprocessApiAudioFeaturesWithLocal     Boolean?
  enableLocalAudioFeatureFallback        Boolean?
  preferApiAudioFeatures                 Boolean?
  allowEstimatedMoodAcousticness         Boolean?
  reprocessLocalAudioFeatures            Boolean?
  localAudioFeaturesScope                String?
  includeEstimatedAudioFeaturesInFilters Boolean?
  audioFeatureMinimumConfidence          Float?
  providerDelayMs                        Int?
  rateLimitBackoffEnabled                Boolean?
  automaticallyShareDuplicateEnrichment  Boolean  @default(true)
  playlistIdentityLearningEnabled        Boolean  @default(true)
  hardDeleteMissingAfterDays             Int?
  createdAt                              DateTime @default(now())
  updatedAt                              DateTime @updatedAt
  revisionCounter                        Int      @default(0)
  user                                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Server {
  id                     String                 @id @default(uuid())
  machineIdentifier      String                 @unique
  name                   String
  uri                    String
  accessToken            String
  userId                 String
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  libraries              Library[]
  playlistRules          PlaylistRule[]
  playlistHistory        PlaylistHistory[]
  playlistHistoryEntries PlaylistHistoryEntry[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

model Library {
  id                       String                    @id @default(uuid())
  plexId                   String
  serverId                 String
  name                     String
  type                     String
  server                   Server                    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  artists                  Artist[]
  albums                   Album[]
  tracks                   Track[]
  syncLogs                 SyncLog[]
  healthSnapshot           LibraryHealthSnapshot?
  playlistRules            PlaylistRule[]
  recentlyAddedBatches     RecentlyAddedBatch[]
  canonicalRecordings      CanonicalRecording[]
  plexSyncConflicts        PlexSyncConflict[]
  playlistTrackMemories    PlaylistTrackMemory[]
  playlistMembershipEvents PlaylistMembershipEvent[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([serverId, plexId])
}

model LibraryHealthSnapshot {
  id        String   @id @default(uuid())
  libraryId String   @unique
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model Artist {
  id                          String                     @id @default(uuid())
  plexId                      String
  libraryId                   String
  title                       String
  summary                     String?
  thumb                       String?
  addedAt                     DateTime?
  updatedAt                   DateTime?
  viewCount                   Int                        @default(0)
  lastViewedAt                DateTime?
  plexLibraryId               String?
  syncStatus                  String                     @default("active")
  lastSeenAt                  DateTime?
  lastSeenSyncId              String?
  missingSince                DateTime?
  deletedAt                   DateTime?
  library                     Library                    @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  albums                      Album[]
  tracks                      Track[]
  tags                        Tag[]                      @relation("ArtistTags")
  userPreferences             UserArtistPreference[]
  playlistIdentityPreferences PlaylistArtistPreference[]

  @@unique([libraryId, plexId])
  @@index([libraryId, syncStatus])
  @@index([libraryId, lastSeenSyncId])
}

model Album {
  id             String    @id @default(uuid())
  plexId         String
  libraryId      String
  artistId       String
  title          String
  summary        String?
  thumb          String?
  year           Int?
  plexTrackCount Int?
  addedAt        DateTime?
  updatedAt      DateTime?
  viewCount      Int       @default(0)
  lastViewedAt   DateTime?
  plexLibraryId  String?
  syncStatus     String    @default("active")
  lastSeenAt     DateTime?
  lastSeenSyncId String?
  missingSince   DateTime?
  deletedAt      DateTime?
  library        Library   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  artist         Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks         Track[]
  tags           Tag[]     @relation("AlbumTags")

  @@unique([libraryId, plexId])
  @@index([libraryId, syncStatus])
  @@index([libraryId, lastSeenSyncId])
}

model Track {
  id                         String                           @id @default(uuid())
  plexId                     String
  ratingKey                  String
  plexGuid                   String?
  plexGuids                  Json?
  mediaPath                  String?
  plexServerId               String
  plexMediaPartId            String?
  fileSize                   BigInt?
  fileFormat                 String?
  bitrate                    Int?
  plexMetadata               Json?
  libraryId                  String
  albumId                    String
  artistId                   String
  title                      String
  duration                   Int?
  trackIndex                 Int?
  rating                     Float?
  contentRating              String?
  normalizedTitle            String?
  isExplicit                 Boolean                          @default(false)
  isLive                     Boolean                          @default(false)
  isRemaster                 Boolean                          @default(false)
  isHoliday                  Boolean                          @default(false)
  isIntroOutro               Boolean                          @default(false)
  viewCount                  Int                              @default(0)
  lastViewedAt               DateTime?
  addedAt                    DateTime?
  updatedAt                  DateTime?
  tagsSyncedAt               DateTime?
  genreStatus                String?
  genreAttemptedAt           DateTime?
  genreFailureReason         String?
  popularityStatus           String?
  popularityAttemptedAt      DateTime?
  popularityFailureReason    String?
  bpm                        Float?
  apiBpm                     Float?
  localBpm                   Float?
  effectiveBpm               Float?
  bpmSource                  String?
  bpmConfidence              Float?
  bpmAnalyzedAt              DateTime?
  bpmAnalysisStatus          String?
  bpmAnalysisScope           String?
  bpmFailureReason           String?
  plexLibraryId              String
  syncStatus                 String                           @default("active")
  lastSyncChangeTypes        String?
  duplicateWarning           String?
  syncConflictReason         String?
  canonicalRecordingId       String?
  duplicateConfidence        String?
  duplicateMatchEvidence     Json?
  duplicateReviewStatus      String                           @default("not_duplicate")
  enrichmentProvenance       Json?
  inheritDuplicateEnrichment Boolean                          @default(true)
  preferredDuplicateCopy     Boolean                          @default(false)
  localFileStatus            String                           @default("not_checked")
  localFileCheckedAt         DateTime?
  lastSeenAt                 DateTime?
  lastSeenSyncId             String?
  missingSince               DateTime?
  deletedAt                  DateTime?
  firstSeenAt                DateTime                         @default(now())
  plexAddedAt                DateTime?
  recentlyAddedProcessedAt   DateTime?
  recentlyAddedStatus        String?
  recentlyAddedBatchId       String?
  library                    Library                          @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  album                      Album                            @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist                     Artist                           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tags                       Tag[]                            @relation("TrackTags")
  popularity                 Popularity?
  audioFeature               AudioFeature?
  blockedBy                  BlockedTrack[]
  exclusions                 TrackExclusion[]
  metadataCorrections        TrackMetadataCorrection[]
  metadataVerifications      TrackMetadataVerification[]
  metadataSourceOverrides    TrackMetadataSourceOverride[]
  metadataCorrectionHistory  TrackMetadataCorrectionHistory[]
  recentlyAddedState         RecentlyAddedTrackState?
  recentlyAddedMatches       RecentlyAddedPlaylistMatch[]
  recentlyAddedChanges       RecentlyAddedAutomationChange[]
  interactionEvents          TrackInteractionEvent[]
  userPreferences            UserTrackPreference[]
  playlistFitFeedback        PlaylistFitFeedback[]
  transitionPreviousFeedback TransitionFeedback[]             @relation("TransitionPreviousTrack")
  transitionCurrentFeedback  TransitionFeedback[]             @relation("TransitionCurrentTrack")
  transitionNextFeedback     TransitionFeedback[]             @relation("TransitionNextTrack")
  canonicalRecording         CanonicalRecording?              @relation("CanonicalRecordingTracks", fields: [canonicalRecordingId], references: [id], onDelete: SetNull)
  preferredForRecordings     CanonicalRecording[]             @relation("PreferredEnrichmentTrack")
  plexSyncConflicts          PlexSyncConflict[]
  PlaylistTrackMemory        PlaylistTrackMemory[]
  PlaylistMembershipEvent    PlaylistMembershipEvent[]

  @@unique([libraryId, plexId])
  @@unique([plexServerId, plexLibraryId, ratingKey])
  @@index([libraryId, syncStatus])
  @@index([libraryId, lastSeenSyncId])
  @@index([libraryId, ratingKey])
  @@index([libraryId, localFileStatus])
  @@index([libraryId, viewCount])
  @@index([canonicalRecordingId, syncStatus])
  @@index([libraryId, duplicateReviewStatus])
  @@index([libraryId, plexGuid])
}

model CanonicalRecording {
  id                         String   @id @default(uuid())
  libraryId                  String
  canonicalArtist            String
  canonicalTitle             String
  confidence                 String   @default("medium")
  matchEvidence              Json?
  reviewStatus               String   @default("confirmed")
  sharedEnrichment           Json?
  enrichmentProvenance       Json?
  preferredEnrichmentTrackId String?
  inheritanceEnabled         Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  library                    Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  tracks                     Track[]  @relation("CanonicalRecordingTracks")
  preferredEnrichmentTrack   Track?   @relation("PreferredEnrichmentTrack", fields: [preferredEnrichmentTrackId], references: [id], onDelete: SetNull)

  @@index([libraryId, reviewStatus])
  @@index([libraryId, canonicalArtist, canonicalTitle])
}

model PlexSyncConflict {
  id                  String    @id @default(uuid())
  libraryId           String
  trackId             String?
  plexRatingKey       String
  plexGuid            String?
  conflictReason      String
  candidateTrackIds   Json?
  duplicateConfidence String?
  matchEvidence       Json?
  plexMetadata        Json?
  resolutionStatus    String    @default("unresolved")
  hasInheritedData    Boolean   @default(false)
  firstDetectedAt     DateTime  @default(now())
  lastDetectedAt      DateTime  @default(now())
  lastSyncBatchId     String?
  resolvedAt          DateTime?
  reviewedAt          DateTime?
  reviewedBy          String?
  library             Library   @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  track               Track?    @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@unique([libraryId, plexRatingKey])
  @@index([libraryId, resolutionStatus, lastDetectedAt])
  @@index([trackId])
  @@index([conflictReason])
}

model TrackMetadataCorrection {
  id                         String   @id @default(cuid())
  trackId                    String
  field                      String
  valueJson                  Json
  previousEffectiveValueJson Json?
  reason                     String?
  isActive                   Boolean  @default(true)
  isVerified                 Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  createdBy                  String?
  track                      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  actor                      User?    @relation("MetadataCorrectionActor", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([trackId])
  @@index([trackId, field, isActive])
}

model TrackMetadataVerification {
  id         String   @id @default(cuid())
  trackId    String
  field      String
  source     String
  verified   Boolean  @default(true)
  verifiedAt DateTime @default(now())
  verifiedBy String?
  note       String?
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  actor      User?    @relation("MetadataVerificationActor", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@unique([trackId, field, source])
  @@index([trackId])
}

model TrackMetadataSourceOverride {
  id        String   @id @default(cuid())
  trackId   String
  field     String
  source    String
  ignored   Boolean  @default(true)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, field, source])
  @@index([trackId])
}

model TrackMetadataCorrectionHistory {
  id           String   @id @default(cuid())
  trackId      String
  field        String
  action       String
  oldValueJson Json?
  newValueJson Json?
  source       String?
  reason       String?
  batchId      String?
  createdAt    DateTime @default(now())
  createdBy    String?
  track        Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  actor        User?    @relation("MetadataHistoryActor", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([trackId, createdAt])
  @@index([batchId])
}

model Tag {
  id      String   @id @default(uuid())
  type    String // genre, mood, style, country, decade
  name    String
  artists Artist[] @relation("ArtistTags")
  albums  Album[]  @relation("AlbumTags")
  tracks  Track[]  @relation("TrackTags")

  @@unique([type, name])
}

model Popularity {
  id            String   @id @default(uuid())
  trackId       String   @unique
  provider      String // deezer, lastfm, spotify
  score         Float // Normalized score 0-100 or 0-1M
  confidence    Float?
  matchedArtist String?
  matchedTitle  String?
  lastUpdated   DateTime @default(now())
  track         Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([score])
}

model AudioFeature {
  id                        String    @id @default(uuid())
  trackId                   String    @unique
  energy                    Float?
  valence                   Float?
  danceability              Float?
  acousticness              Float?
  apiEnergy                 Float?
  apiMood                   Float?
  apiDanceability           Float?
  apiAcousticness           Float?
  apiLoudness               Float?
  localEnergy               Float?
  localMood                 Float?
  localDanceability         Float?
  localAcousticness         Float?
  localLoudness             Float?
  effectiveEnergy           Float?
  effectiveMood             Float?
  effectiveDanceability     Float?
  effectiveAcousticness     Float?
  tempo                     Float?
  loudness                  Float?
  dynamicComplexity         Float?
  key                       String?
  scale                     String?
  spectralCentroid          Float?
  spectralContrast          Float?
  rhythmStability           Float?
  onsetRate                 Float?
  zeroCrossingRate          Float?
  replayGain                Float?
  source                    String?
  confidence                Float?
  tempoSource               String?
  tempoConfidence           Float?
  audioFeatureSource        String?
  audioFeatureStatus        String?
  audioFeatureConfidence    Float?
  audioFeatureAnalyzedAt    DateTime?
  audioFeatureFailureReason String?
  audioFeatureAnalysisScope String?
  energySource              String?
  valenceSource             String?
  danceabilitySource        String?
  acousticnessSource        String?
  lastUpdated               DateTime  @default(now())
  track                     Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model BlockedTrack {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model TrackExclusion {
  id        String   @id @default(uuid())
  userId    String
  trackId   String   @unique
  reason    String?
  notes     String?
  source    String   @default("manual")
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PlaylistRule {
  id                String            @id @default(uuid())
  userId            String
  serverId          String?
  libraryId         String?
  name              String
  rulesJson         String // JSON string of builder filters
  optionsJson       String            @default("{}")
  limit             Int               @default(50)
  autoRefresh       Boolean           @default(false)
  plexPlaylistId    String?
  lastRefreshedAt   DateTime?
  lastRefreshStatus String?
  lastRefreshError  String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  server            Server?           @relation(fields: [serverId], references: [id], onDelete: SetNull)
  library           Library?          @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  history           PlaylistHistory[]
}

model PlaylistRecipe {
  id                 String    @id @default(uuid())
  userId             String
  name               String
  description        String?
  filtersJson        Json
  createdFromVersion String?
  isFavorite         Boolean   @default(false)
  isArchived         Boolean   @default(false)
  lastUsedAt         DateTime?
  useCount           Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, lastUsedAt])
}

model PlaylistHistory {
  id             String        @id @default(uuid())
  userId         String
  playlistRuleId String?
  serverId       String?
  name           String
  rulesJson      String
  optionsJson    String        @default("{}")
  trackCount     Int
  plexPlaylistId String?
  status         String
  error          String?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistRule   PlaylistRule? @relation(fields: [playlistRuleId], references: [id], onDelete: SetNull)
  server         Server?       @relation(fields: [serverId], references: [id], onDelete: SetNull)
}

model GeneratedPlaylist {
  id                     String                          @id @default(uuid())
  userId                 String
  serverId               String?
  plexPlaylistRatingKey  String?
  plexPlaylistTitle      String
  sourceType             String                          @default("unknown")
  engineVersion          String                          @default("v1")
  recipeId               String?
  recipeName             String?
  smartPresetId          String?
  smartPresetName        String?
  moodPresetId           String?
  moodPresetName         String?
  bpmPresetId            String?
  bpmPresetName          String?
  tuningPresetName       String?
  tuningConfigJson       Json?
  discoveryConfigJson    Json?
  discoveryResultJson    Json?
  filtersJson            Json
  safetyRulesJson        Json?
  qualityScoreJson       Json?
  scoringModel           String                          @default("stable-v2")
  scoringModelVersion    String                          @default("2")
  betaMetadataJson       Json?
  adaptiveScoringVersion String?
  adaptiveSettingsJson   Json?
  trackCount             Int                             @default(0)
  lastGeneratedAt        DateTime                        @default(now())
  lastRegeneratedAt      DateTime?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  revisionCounter        Int                             @default(0)
  user                   User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks                 GeneratedPlaylistTrack[]
  historyEntries         PlaylistHistoryEntry[]
  regenerations          PlaylistRegeneration[]
  revisions              PlaylistRevision[]
  automationSettings     PlaylistAutomationSettings?
  recentlyAddedMatches   RecentlyAddedPlaylistMatch[]
  recentlyAddedChanges   RecentlyAddedAutomationChange[]
  preferenceProfile      PlaylistPreferenceProfile?
  interactionEvents      TrackInteractionEvent[]
  playlistFitFeedback    PlaylistFitFeedback[]
  transitionFeedback     TransitionFeedback[]
  identity               PlaylistIdentity?
  adaptiveScoringSetting AdaptivePlaylistScoringSetting?

  @@unique([userId, plexPlaylistRatingKey])
  @@index([userId, updatedAt])
  @@index([userId, sourceType])
}

model SmartMixTuningPreset {
  id            String   @id @default(uuid())
  userId        String
  name          String
  configJson    Json
  tuningVersion String   @default("2.0.8")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model GeneratedPlaylistTrack {
  id                   String            @id @default(uuid())
  generatedPlaylistId  String
  trackId              String?
  plexTrackRatingKey   String?
  position             Int
  title                String
  artist               String?
  album                String?
  locked               Boolean           @default(false)
  liked                Boolean           @default(false)
  regenerationExcluded Boolean           @default(false)
  adaptiveScoreJson    Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  generatedPlaylist    GeneratedPlaylist @relation(fields: [generatedPlaylistId], references: [id], onDelete: Cascade)

  @@index([generatedPlaylistId, position])
  @@index([trackId])
  @@index([generatedPlaylistId, trackId])
}

model PlaylistRegeneration {
  id                  String                       @id @default(uuid())
  userId              String
  generatedPlaylistId String
  mode                String
  status              String                       @default("preview")
  settingsJson        Json
  warningsJson        Json?
  originalScore       Float?
  proposedScore       Float?
  appliedScore        Float?
  originalDurationMs  Int                          @default(0)
  proposedDurationMs  Int                          @default(0)
  tracksAnalyzed      Int                          @default(0)
  tracksProposed      Int                          @default(0)
  tracksApplied       Int                          @default(0)
  engineVersion       String                       @default("v2.0.8")
  playlistUpdatedAt   DateTime
  createdAt           DateTime                     @default(now())
  appliedAt           DateTime?
  undoneAt            DateTime?
  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedPlaylist   GeneratedPlaylist            @relation(fields: [generatedPlaylistId], references: [id], onDelete: Cascade)
  changes             PlaylistRegenerationChange[]

  @@index([userId, createdAt])
  @@index([generatedPlaylistId, createdAt])
  @@index([generatedPlaylistId, status])
}

model PlaylistRegenerationChange {
  id                  String               @id @default(uuid())
  regenerationId      String
  position            Int
  originalTrackId     String
  proposedTrackId     String
  originalScore       Float?
  proposedScore       Float?
  improvement         Float?
  reasonsJson         Json?
  originalMetricsJson Json?
  proposedMetricsJson Json?
  accepted            Boolean?
  createdAt           DateTime             @default(now())
  regeneration        PlaylistRegeneration @relation(fields: [regenerationId], references: [id], onDelete: Cascade)

  @@unique([regenerationId, position])
  @@index([regenerationId, accepted])
}

model PlaylistRevision {
  id                    String                    @id @default(uuid())
  generatedPlaylistId   String
  revisionNumber        Int
  regenerationId        String?
  reason                String
  label                 String?
  description           String?
  engineFamily          String?
  engineVersion         String?
  applicationVersion    String?
  snapshotSchemaVersion Int                       @default(1)
  settingsSnapshot      Json?
  trackSnapshot         Json
  scoreSnapshot         Json?
  betaMetadata          Json?
  trackCount            Int                       @default(0)
  durationMs            Int                       @default(0)
  restoredFromVersionId String?
  isPinned              Boolean                   @default(false)
  isAutomatic           Boolean                   @default(true)
  isCurrent             Boolean                   @default(false)
  syncStatus            String                    @default("synced")
  snapshotSizeBytes     Int?
  createdAt             DateTime                  @default(now())
  generatedPlaylist     GeneratedPlaylist         @relation(fields: [generatedPlaylistId], references: [id], onDelete: Cascade)
