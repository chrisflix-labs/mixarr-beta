# Database Configuration
POSTGRES_USER=mixarr
POSTGRES_PASSWORD=mixarrpass
POSTGRES_DB=mixarrdb
DATABASE_URL=postgresql://mixarr:mixarrpass@db:5432/mixarrdb?schema=public
# Optional Prisma pool tuning. Prefer fixing concurrency first; these are
# escape hatches for larger installs.
# DATABASE_URL=postgresql://mixarr:mixarrpass@db:5432/mixarrdb?schema=public&connection_limit=20&pool_timeout=20
MIXARR_DB_JOB_CONCURRENCY=4
MIXARR_GROUP_REGENERATION_CONCURRENCY=2
MIXARR_STATUS_POLL_SECONDS=10
MIXARR_STATUS_IDLE_POLL_SECONDS=30
MIXARR_STATUS_CACHE_SECONDS=5
PLAYLIST_HEALTH_BATCH_SIZE=100

# Mixarr v2.4.19 storage ownership. Docker defaults are mounted by the supplied
# Compose file; bare-metal defaults live below the current user's .mixarr home.
MIXARR_CONFIG_DIR=/config
MIXARR_DATA_DIR=/data
MIXARR_CACHE_DIR=/data/cache
MIXARR_TEMP_DIR=/data/temp
MIXARR_ARTWORK_DIR=/data/artwork
MIXARR_BACKUP_DIR=/data/backups
MIXARR_EXPORT_DIR=/data/exports
MIXARR_JOB_DIR=/data/jobs
MIXARR_SCAN_DIR=/data/scans
MIXARR_LOG_DIR=/data/logs
MIXARR_CACHE_ENABLED=true
# Positive GiB or the explicit word "unlimited". Zero/negative values are rejected.
MIXARR_CACHE_MAX_SIZE_GB=10
MIXARR_CACHE_RETENTION_DAYS=30
MIXARR_TEMP_RETENTION_HOURS=24
MIXARR_JOB_RETENTION_DAYS=14
MIXARR_SCAN_HISTORY_RETENTION_DAYS=30
MIXARR_AI_HISTORY_RETENTION_DAYS=30
MIXARR_STORAGE_WARNING_PERCENT=80
MIXARR_STORAGE_CRITICAL_PERCENT=90
MIXARR_MIN_FREE_SPACE_GB=10
MIXARR_SCAN_BATCH_SIZE=500
MIXARR_SCAN_MAX_CONCURRENCY=4
MIXARR_SCAN_PROGRESS_INTERVAL=1000
# Secret encryption for API credentials and Plex/media integration secrets.
# Set this to a long random value before saving credentials in Settings.
MIXARR_SECRET_KEY=

# AI provider credentials use authenticated AES-256-GCM encryption. Prefer a
# dedicated random value supplied as a Docker secret or environment variable.
# If blank, Mixarr falls back to MIXARR_SECRET_KEY for compatibility. AI still
# starts disabled and local providers without credentials can still be saved.
AI_CREDENTIAL_ENCRYPTION_KEY=
# Deployment-level emergency override. When false, no provider-bound AI work,
# health checks, discovery, retries, or queued execution can run.
MIXARR_AI_ENABLED=true
# Hard server caps for future AI requests and streams.
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_STREAM_DURATION_MS=300000
AI_STREAM_IDLE_TIMEOUT_MS=30000
AI_HEALTH_CHECK_CONCURRENCY=2

# Beta support links
# Leave Discord blank to disable the Discord support button gracefully.
DISCORD_SUPPORT_URL=
GITHUB_REPO_URL=https://github.com/cvarano84/mixarr-beta
GITHUB_ISSUES_URL=https://github.com/cvarano84/mixarr-beta/issues/new/choose
BETA_FEEDBACK_URL=
GITHUB_SPONSORS_URL=
GITHUB_SPONSORS_BETA_TEXT=

# Beta program server ceiling. All are disabled by default. Private beta also
# implies public beta; developer features are refused in production.
MIXARR_BETA_PROGRAM_ENABLED=false
MIXARR_PRIVATE_BETA_ENABLED=false
MIXARR_DEVELOPER_FEATURES_ENABLED=false
# Optional comma-separated User UUIDs, Plex IDs, usernames, or email addresses.
MIXARR_ADMIN_USER_IDS=
# Emergency switches override database and user preferences immediately.
MIXARR_DISABLED_FEATURES=
MIXARR_DISABLE_ALL_EXPERIMENTAL_FEATURES=false

# Plex Authentication
# Generate a random UUID for the client identifier (e.g. using uuidgen)
PLEX_CLIENT_IDENTIFIER=your-random-uuid-here
PLEX_PRODUCT_NAME="Mixarr Playlist Curator"
PLEX_OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Popularity Providers (deezer, lastfm, spotify)
DEFAULT_POPULARITY_PROVIDER=deezer
POPULARITY_REFRESH_DAYS=30

# Track Genre Providers
# Lookup order defaults to Deezer -> Discogs -> MusicBrainz -> optional Spotify -> Last.fm fallback.
# Disabled providers in the list are skipped.
TRACK_TAG_PROVIDER_ORDER=deezer,discogs,musicbrainz,spotify,lastfm
TRACK_TAG_MAX_TAGS=8

# Deezer album genre tags. No API key is needed.
DEEZER_TAGS_ENABLED=1

# Discogs genre/style tags.
# Disabled by default because Discogs API content has attribution/cache terms.
# For public database lookups, register an app and set Consumer Key/Secret.
# Full OAuth 1.0a flow endpoints, if you choose to generate access tokens:
# Request Token URL: https://api.discogs.com/oauth/request_token
# Authorize URL: https://www.discogs.com/oauth/authorize
# Access Token URL: https://api.discogs.com/oauth/access_token
DISCOGS_TAGS_ENABLED=0
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_ACCESS_TOKEN=
DISCOGS_ACCESS_TOKEN_SECRET=
DISCOGS_USER_AGENT=Mixarr/1.0
# Minimum spacing between Discogs API calls in milliseconds. Discogs's
# authenticated rate cap is 60 req/min; 1100ms (~55 req/min) keeps us
# safely under it. Set to 0 to disable the throttle (not recommended).
DISCOGS_RATE_LIMIT_MS=1100

# MusicBrainz genre/tags. No API key is needed, but a meaningful User-Agent
# is required and the public API allows no more than one request per second.
MUSICBRAINZ_TAGS_ENABLED=1
MUSICBRAINZ_USER_AGENT="Mixarr/1.0 (your-email@example.com)"
MUSICBRAINZ_MIN_REQUEST_INTERVAL_MS=1100

# Last.fm
# Used by popularity fallback and only as the final Track Genres fallback.
LASTFM_API_KEY=
LASTFM_TAG_FALLBACK_ENABLED=1

# Last.fm autocorrect (0 = off, 1 = on; default off)
# When enabled, Last.fm corrects misspelled / mis-cased artist & track
# names server-side before looking up the record. Catches case drift,
# accent loss ("Beyonce" vs "Beyoncé"), and "feat." / "ft." / "featuring"
# variations - typically lifts tag hit rate significantly when Plex
# metadata isn't already canonicalized.
#
# Tradeoff: occasional false positives on obscure tracks with similar
# names (you'll get the popular track's tags instead of nothing).
# The metric `mixarr_lastfm_autocorrections_total` (broken down by
# field=artist|track|both) makes the rate of corrections visible on the
# Grafana dashboard so you can spot pathological cases.
LASTFM_AUTOCORRECT=0

# Spotify
# Used for popularity/audio features. Spotify artist genres are optional for
# Track Genres and are disabled by default because the artist genre field is
# deprecated in Spotify's Web API docs and subject to Spotify metadata terms.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_TAGS_ENABLED=0

# Playlist Configuration
MAX_PLAYLIST_SIZE=5000
# Playlist Builder V2 generation safety. Defaults are safe for normal use;
# tune only after reviewing Job History and structured generation logs.
PLAYLIST_GENERATION_MAX_RUNTIME_MINUTES=12
PLAYLIST_GENERATION_MAX_TRACKS=5000
PLAYLIST_GENERATION_QUERY_BATCH_SIZE=500
PLAYLIST_GENERATION_CONCURRENCY=1
PLAYLIST_GENERATION_MAX_SELECTION_ATTEMPTS=300
PLAYLIST_GENERATION_MAX_OPTIMIZATION_PASSES=1
PLAYLIST_GENERATION_MAX_TUNING_PASSES=1
PLAYLIST_GENERATION_MAX_MOOD_TRANSITION_PASSES=1
PLAYLIST_GENERATION_MAX_CANDIDATE_RESCORING_PASSES=1
PLAYLIST_GENERATION_MAX_FALLBACK_ATTEMPTS=2
PLAYLIST_GENERATION_MAX_REPLACEMENT_ATTEMPTS=2
PLAYLIST_GENERATION_STAGE_TIMEOUT_SECONDS=180
PLAYLIST_GENERATION_PROGRESS_INTERVAL_MS=750
PLAYLIST_GENERATION_HEARTBEAT_TIMEOUT_SECONDS=90

# Local BPM and Audio Feature Backfill
# Deezer is tried first, then Plex audio is sampled with ffmpeg.
# Provider controls default safely to API and local enabled, API preferred.
# Accepted scope values are windows and whole_track.
# LOCAL_BPM_ANALYZER=auto prefers Essentia when available and falls back to Aubio.
# LOCAL_BPM_ANALYSIS_SCOPE=windows samples 30s-90s, the middle window, and the last-third window.
# Use whole_track for slower full-track local analysis.
# LOCAL_AUDIO_FEATURES_SCOPE uses the same windows/whole_track choices for Essentia audio features.
# LOCAL_AUDIO_FEATURES_AUTO_BACKFILL=0 keeps automatic initial enrichment from
# launching a large CPU-heavy local Essentia job. Manual Audio Feature sync can
# still run local fallback when enabled in Sync Controls.
# To avoid Plex transcode URL failures in Docker, mount your media into the app
# container and map Plex host paths to container paths. These env vars do not
# mount the folder by themselves; add the matching read-only volume in Compose.
# MIXARR_PATH_MAPPINGS can contain multiple comma-separated host:container entries.
# Batch limits are configured in Settings > Sync Controls.
ENABLE_API_BPM=true
ENABLE_LOCAL_BPM=true
PREFER_LOCAL_BPM=false
REPROCESS_API_BPM_WITH_LOCAL=false
LOCAL_BPM_ANALYZER=auto
LOCAL_BPM_ANALYSIS_SCOPE=windows
LOCAL_BPM_CONCURRENCY=1
LOCAL_BPM_ANALYSIS_TIMEOUT_SECONDS=300
LOCAL_BPM_SAMPLE_SECONDS=60
LOCAL_BPM_MIN_SAMPLE_SECONDS=10
LOCAL_BPM_MIN_SAMPLE_BYTES=65536
LOCAL_BPM_RETRY_DAYS=14
LOCAL_BPM_CONFIDENCE_THRESHOLD=0.75
LOCAL_BPM_FFMPEG_PATH=ffmpeg
LOCAL_BPM_FFPROBE_PATH=ffprobe
LOCAL_BPM_ESSENTIA_PYTHON=/opt/essentia/bin/python
LOCAL_BPM_AUBIO_PATH=aubio
LOCAL_BPM_TEMP_DIR=/data/temp/bpm
LOCAL_AUDIO_FEATURE_TEMP_DIR=/data/temp/audio-features
LOCAL_BPM_REPROCESS_AUBIO_WITH_ESSENTIA=0
LOCAL_BPM_REPROCESS_NO_DATA_FAILED=0
ENABLE_API_AUDIO_FEATURES=true
ENABLE_LOCAL_AUDIO_FEATURES=true
PREFER_LOCAL_AUDIO_FEATURES=false
REPROCESS_API_AUDIO_FEATURES_WITH_LOCAL=false
LOCAL_AUDIO_FEATURES_SCOPE=windows
LOCAL_AUDIO_FEATURES_CONCURRENCY=1
LOCAL_AUDIO_FEATURES_ANALYSIS_TIMEOUT_SECONDS=300
LOCAL_AUDIO_FEATURES_MIN_DURATION_SECONDS=10
LOCAL_AUDIO_FEATURES_ALLOW_SHORT_TRACKS=false
ALLOW_ESTIMATED_AUDIO_FEATURES=true
LOCAL_AUDIO_FEATURES_AUTO_BACKFILL=0
PLEX_MEDIA_PATH_HOST=
MIXARR_MEDIA_PATH_CONTAINER=
MIXARR_PATH_MAPPINGS=

# Background Scheduler
# Schedule for autonomous nightly library & metadata sync (Cron syntax)
# Default is 3:00 AM every day
SYNC_CRON_SCHEDULE="0 3 * * *"

# Hard wall-clock deadline (in milliseconds) for the nightly pipeline.
# If a slow / hung step exceeds this, the scheduler aborts so the next
# nightly tick can run cleanly. Default 6h.
SYNC_MAX_PIPELINE_MS=21600000

# Prometheus Metrics
# Port for the /metrics endpoint. Set to 0 (default) to disable the
# metrics server entirely. If you change this, you'll also need to map
# the port in your docker-compose.yml to make it reachable from the host.
METRICS_PORT=0
METRICS_AUTH_TOKEN=
METRICS_TRUSTED_NETWORKS=
METRICS_ALLOW_UNAUTHENTICATED=false

# v2.3.7 media ecosystem integrations
# Public base URL used only to generate recipe import links. Without this,
# Discord shares include a portable payload instead.
MIXARR_PUBLIC_URL=
# Private webhook destinations are blocked by default. Enable only on a trusted network.
MIXARR_ALLOW_PRIVATE_WEBHOOKS=false
# Plex/Tautulli are commonly private-network services; disable only when all are public.
MIXARR_ALLOW_PRIVATE_INTEGRATIONS=true
# Delay destructive Plex comparisons after a library scan completes.
PLEX_SCAN_GRACE_MINUTES=10
# Availability, mount, change-detection, and webhook-retry worker schedules.
INTEGRATION_SCHEDULER_ENABLED=true
INTEGRATION_HEALTH_CRON="*/5 * * * *"
INTEGRATION_RETENTION_CRON="17 3 * * *"
# Bounded history retention.
WEBHOOK_HISTORY_RETENTION_DAYS=30
INTEGRATION_TEST_RETENTION_DAYS=30
EXTERNAL_SNAPSHOT_RETENTION_DAYS=90
INTEGRATION_HEALTH_RETENTION_DAYS=30
INTEGRATION_EVENT_RETENTION_DAYS=90
PUBLIC_API_RATE_LIMIT_PER_MINUTE=120

# Emit bounded Smart Mix explanation trace diagnostics. Normal operation logs one generation summary only.
SMART_MIX_EXPLANATION_DEBUG=false
# Household collaboration uses persisted settings and the existing session,
# Plex, scheduler, and database configuration. No additional secrets or
# environment variables are required for v2.3.6.
# Playlist orchestration settings are persisted through the admin Settings UI.
# Safe upgrade defaults: orchestration disabled, concurrency 1, auto-registration disabled.
# Worker lease/heartbeat defaults continue to use WORKER_* values below; per-job stale timeout is persisted separately.
# v2.2.9 dashboard time ranges, onboarding, retention, import/export, and safety
# preferences are also persisted in the database; no secrets belong in exports.
# Ecosystem trend snapshots run in the existing nightly scheduler and do not
# introduce a second schedule or a full-library dashboard scan.
# Maximum Smart Refresh playlists evaluated per background scheduler run.
SMART_REFRESH_EVALUATION_BATCH_SIZE=20
# Optional read-only community recipe repository. Core import/export works without it.
COMMUNITY_RECIPES_ENABLED=true
COMMUNITY_RECIPES_REPOSITORY=
COMMUNITY_RECIPES_BRANCH=main
COMMUNITY_RECIPES_INDEX=index.json
# Mixarr v2.4.6 advisory AI features. Per-user and per-feature settings still
# default metadata scans and provider execution to disabled after upgrade.
AI_PLAYLIST_SUMMARIES_ENABLED=true
AI_METADATA_SUGGESTIONS_ENABLED=true
# AI metadata writes are intentionally unavailable and are not configurable.
AI_METADATA_WRITES_ENABLED=false
